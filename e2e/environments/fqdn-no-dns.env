# An instance that answers on an address but is published under a host
# name DNS does not know -- a test box, or a stack whose WEKO is
# configured for weko3.example.org.
#
# WEKO builds its absolute URLs from the Host header, so the run has to
# ask for the host name; WEKO_E2E_HOST_IP says where to send it. Both the
# browser and the HTTP client honour it, so no /etc/hosts entry and no
# root are needed.

WEKO_BASE_URL=https://weko3.example.org
WEKO_E2E_HOST_IP=127.0.0.1

# A self signed certificate will not verify against that name.
WEKO_E2E_VERIFY_TLS=0

WEKO_TEST_EMAIL=wekosoftware@nii.ac.jp
WEKO_TEST_PASSWORD=uspass123

# For a rule the simple form cannot express, set the chromium host
# resolver rule yourself; it wins over WEKO_E2E_HOST_IP.
#WEKO_HOST_MAP=MAP weko3.example.org 127.0.0.1
