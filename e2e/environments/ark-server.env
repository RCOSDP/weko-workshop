# Minting ARKs against an ARK server of your own.
#
#   e2ectl ark-account enable    writes these into the instance
#   pytest --suite ark           registers an item and checks its ARK
#   e2ectl ark-account disable   takes them away again
#
# WEKO always needs the mint URL, the NAAN and the shoulder, and then
# either an API key or the three login settings. There is no admin screen
# for any of it; it is instance configuration.

WEKO_E2E_SUITES=ark

WEKO_E2E_ARK_MINT_URL=https://ark.example.org/api/mint
WEKO_E2E_ARK_NAAN=12345
WEKO_E2E_ARK_SHOULDER=x9
WEKO_E2E_ARK_TIMEOUT=30

# Either an API key...
WEKO_E2E_ARK_API_KEY=change-me
#WEKO_E2E_ARK_API_KEY_HEADER=Authorization
#WEKO_E2E_ARK_API_KEY_PREFIX=Bearer
# ...or a login, when the server has no keys. Leave the API key empty then.
#WEKO_E2E_ARK_LOGIN_URL=https://ark.example.org/api/login
#WEKO_E2E_ARK_LOGIN_USER=you
#WEKO_E2E_ARK_LOGIN_PASSWD=change-me
