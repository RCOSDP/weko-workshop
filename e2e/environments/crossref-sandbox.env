# Depositing to Crossref's sandbox, with an account of your own.
#
#   e2ectl crossref-account enable    writes these into the instance
#   pytest --suite crossref           grants a DOI and waits for the deposit
#   e2ectl crossref-account disable   takes them away again
#
# The prefix has to be one this account may register under; 10.5555 is
# Crossref's example prefix and is fine for granting, not for depositing.

WEKO_E2E_SUITES=crossref
WEKO_E2E_CROSSREF_DEPOSIT=1
WEKO_E2E_CROSSREF_PREFIX=10.80000

WEKO_E2E_CROSSREF_LOGIN_ID=you@example.org/role
WEKO_E2E_CROSSREF_LOGIN_PASSWD=change-me
WEKO_E2E_CROSSREF_DEPOSITOR_NAME=Your Repository
WEKO_E2E_CROSSREF_DEPOSITOR_EMAIL=you@example.org
WEKO_E2E_CROSSREF_REGISTRANT=Your Repository

# The sandbox. These are WEKO's own defaults, spelled out to be changed.
WEKO_E2E_CROSSREF_DEPOSIT_URL=https://test.crossref.org/servlet/deposit
WEKO_E2E_CROSSREF_SUBMISSION_LOG_URL=https://test.crossref.org/servlet/submissionDownload

# Crossref's test system can take a while to judge a submission.
WEKO_E2E_CROSSREF_DEPOSIT_TIMEOUT=900
