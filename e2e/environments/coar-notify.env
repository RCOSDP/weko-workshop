# Checking that the workflow is announced over COAR Notify.
#
#   pytest --suite coarnotify    registers an item, has a second account
#                                approve it, and reads both notifications
#   e2ectl inbox --run <id>      what that run announced, and to whom
#
# A stack from install.sh needs nothing set: the inbox service is the LDN
# inbox, WEKO_NOTIFICATIONS is already on in scripts/instance.cfg, and
# repoadmin@example.org is the repository administrator every approval
# request is sent to. This file is here to be copied where one of those
# is somebody else.

WEKO_E2E_SUITES=coarnotify

# Who registers, and who approves. They have to be two different people:
# WEKO leaves the person who acted out of the notification about their
# own action, so a run in which one account did both would see nothing.
WEKO_TEST_EMAIL=wekosoftware@nii.ac.jp
WEKO_TEST_PASSWORD=uspass123
WEKO_E2E_APPROVER_EMAIL=repoadmin@example.org
WEKO_E2E_APPROVER_PASSWORD=uspass123

# How long to wait for a notification to reach the inbox. It is usually
# there by the time the screen comes back; raise it for a slow instance.
WEKO_E2E_NOTIFY_TIMEOUT=120

# The compose service running the inbox, which "clean --hard" clears the
# run's notifications out of.
#WEKO_E2E_INBOX_SERVICE=inbox
