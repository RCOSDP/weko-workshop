# An instance published under a real host name, with a real certificate.
# Nothing here needs docker: e2ectl clean works, only clean --hard does
# not, because it runs the purge inside the web container.

WEKO_BASE_URL=https://repository.example.org
WEKO_E2E_VERIFY_TLS=1

WEKO_TEST_EMAIL=e2e-admin@example.org
WEKO_TEST_PASSWORD=change-me

# A remote instance is slower than a local one.
WEKO_E2E_TIMEOUT=120000
WEKO_E2E_STEP_TIMEOUT=600
WEKO_E2E_UPLOAD_TIMEOUT=600
WEKO_E2E_SEARCH_TIMEOUT=600

# Keep the run's resources apart from another team's on a shared instance.
WEKO_E2E_LABEL=E2E-alice

# Crossref: grant only by default. To deposit as well, give it an account
# (e2ectl crossref-account enable writes these into the instance) and a
# prefix that account may register under. Deposits go to Crossref's test
# system unless WEKO_E2E_CROSSREF_DEPOSIT_URL says otherwise.
#WEKO_E2E_SUITES=crossref
#WEKO_E2E_CROSSREF_DEPOSIT=1
#WEKO_E2E_CROSSREF_LOGIN_ID=you@example.org/role
#WEKO_E2E_CROSSREF_LOGIN_PASSWD=change-me
#WEKO_E2E_CROSSREF_DEPOSITOR_EMAIL=you@example.org
#WEKO_E2E_CROSSREF_PREFIX=10.80000
