# A stack brought up by install.sh on this machine.
# This is what the suite assumes when nothing is set, so an empty file
# would do; it is spelled out to be copied and changed.

WEKO_BASE_URL=https://localhost
WEKO_TEST_EMAIL=wekosoftware@nii.ac.jp
WEKO_TEST_PASSWORD=uspass123

# The WEKO checkout whose containers these are. Found automatically when
# it sits next to this repository and is named wekov2, weko3 or weko.
#WEKO_E2E_REPO=/home/you/wekov2
#WEKO_E2E_COMPOSE_FILE=docker-compose2.yml
#WEKO_E2E_WEB_SERVICE=web
