<?xml version="1.0" encoding="UTF-8"?>
<!--
  ワークショップ用の属性定義。ディレクトリサーバを立てないので、すべてログイン ID (uid) から導出する。
  WEKO3 が必要とするのは以下の 4 つ:
    eduPersonPrincipalName -> eppn                   (SP 側で Remote-User にもなる)
    mail                   -> mail                   (WEKO アカウントの照合キー)
    displayName            -> DisplayName            (WEKO の shib_user_name)
    wekoSocietyAffiliation -> HTTP_WEKOSOCIETYAFFILIATION (WEKO のロール決定に使う)
  加えて wekoId を HTTP_WEKOID として渡す。

  Attribute definitions for the workshop. No directory server is involved, so everything is derived from
  the login id (uid). WEKO3 needs these four:
    eduPersonPrincipalName -> eppn                   (also becomes Remote-User on the SP side)
    mail                   -> mail                   (the key used to match a WEKO account)
    displayName            -> DisplayName            (WEKO's shib_user_name)
    wekoSocietyAffiliation -> HTTP_WEKOSOCIETYAFFILIATION (drives WEKO's role assignment)
  wekoId is additionally passed through as HTTP_WEKOID.
-->
<AttributeResolver
        xmlns="urn:mace:shibboleth:2.0:resolver"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:mace:shibboleth:2.0:resolver http://shibboleth.net/schema/idp/shibboleth-attribute-resolver.xsd">

    <!-- 認証されたログイン ID そのもの / the authenticated login id itself -->
    <AttributeDefinition id="uid" xsi:type="PrincipalName" />

    <!-- eppn = <uid>@<idp.scope> -->
    <AttributeDefinition id="eduPersonPrincipalName" xsi:type="Scoped" scope="%{idp.scope}">
        <InputAttributeDefinition ref="uid" />
    </AttributeDefinition>

    <!-- mail = <uid>@<idp.scope>。tenants.txt の管理者メールと一致させると初回ログインの紐付けが楽。
         Template の本文は Velocity のテンプレートでもあり ${...} と %{...} が混ざると読みにくいので、
         スコープは __IDP_SCOPE__ として Dockerfile のビルド時に sed で埋めている
         (IdP 同梱の既定設定も、ここは example.org を直書きしている)。
         mail = <uid>@<idp.scope>. Matching it to the admin e-mail in tenants.txt makes the first-login
         account linking straightforward. The Template body is also a Velocity template, and mixing
         ${...} with %{...} reads badly, so the scope is substituted from __IDP_SCOPE__ by sed at image
         build time (the IdP's own default config hardcodes example.org here as well). -->
    <AttributeDefinition id="mail" xsi:type="Template">
        <InputAttributeDefinition ref="uid" />
        <Template><![CDATA[${uid}@__IDP_SCOPE__]]></Template>
    </AttributeDefinition>

    <AttributeDefinition id="displayName" xsi:type="Template">
        <InputAttributeDefinition ref="uid" />
        <Template><![CDATA[${uid}]]></Template>
    </AttributeDefinition>

    <AttributeDefinition id="wekoId" xsi:type="Simple">
        <InputAttributeDefinition ref="uid" />
    </AttributeDefinition>

    <!-- WEKO のロールは wekoSocietyAffiliation の文字列で決まる (weko-accounts の
         WEKO_ACCOUNTS_SHIB_ROLE_RELATION: 管理者/図書館員/教員/教官)。ここではログイン ID から静的に割り当てる。
         WEKO's role is decided from the wekoSocietyAffiliation string (weko-accounts'
         WEKO_ACCOUNTS_SHIB_ROLE_RELATION: 管理者/図書館員/教員/教官). Here it is assigned statically
         from the login id. -->
    <!-- DefaultValue はあえて置いていない。wekoSocietyAffiliation は WEKO 独自の拡張属性なので、
         機関外の学認 IdP や Orthros はそもそも送ってこない。その状況を再現するため、下の
         gakunin / orthrosin / orthrosout には値を出さない (Mapped は一致しなければ何も返さない)。
         属性が無くても weko-accounts の assign_user_role() は素通りするだけで、ログインは通る
         (nginx が NO_CHECK_WEKOSOCIETYAFFILIATION=TRUE を渡しているため)。
         ここにユーザを足すと wekoSocietyAffiliation 由来のロールは付かなくなるので、機関ユーザを
         増やすときは ValueMap も併せて足すこと。
         There is deliberately no DefaultValue. wekoSocietyAffiliation is a WEKO-specific extension
         attribute, so an out-of-institution GakuNin IdP or Orthros never sends it. To reproduce that,
         gakunin / orthrosin / orthrosout below get no value (a Mapped definition returns nothing when
         no ValueMap matches). Login still succeeds without it - weko-accounts' assign_user_role()
         simply falls through, because nginx passes NO_CHECK_WEKOSOCIETYAFFILIATION=TRUE.
         A new user added here therefore gets no wekoSocietyAffiliation-derived role, so add a ValueMap
         alongside when the user is meant to be an institutional one. -->
    <AttributeDefinition id="wekoSocietyAffiliation" xsi:type="Mapped">
        <InputAttributeDefinition ref="uid" />
        <ValueMap>
            <ReturnValue>管理者</ReturnValue>
            <SourceValue>admin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>図書館員</ReturnValue>
            <SourceValue>libadmin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>教員</ReturnValue>
            <SourceValue>teacher|commadmin</SourceValue>
        </ValueMap>
    </AttributeDefinition>

    <!-- 機関外の学認 IdP / Orthros 経由のユーザを表す組織名 (urn:oid:2.5.4.10)。
         weko-accounts はこれを shib_organization として受け取り、_find_organization_name() が
         WEKO_ACCOUNTS_GAKUNIN_ROLE / _ORTHROS_INSIDE_ROLE / _ORTHROS_OUTSIDE_ROLE / _EXTRA_ROLE の
         organizationName と突き合わせて defaultRole を付ける。
         重要: この経路が一致すると check_in() は学認mAP のグループ経路を丸ごとスキップする
         (`if not self._find_organization_name(): self._assign_roles_to_user(...)`)。
         つまり「学認認証だけで入ってくるユーザ」はグループではなく組織名でロールが決まる。
         id=o は IdP 5 標準の属性レジストリ (conf/attributes/inetOrgPerson.xml) に登録済みなので、
         custom の .properties は要らない。SP 側も同梱の attribute-map.xml が urn:oid:2.5.4.10 -> o を
         持っており、nginx の shib_fastcgi_params が fastcgi_param o として素通しする。

         The organization name (urn:oid:2.5.4.10) identifying a user who arrives through an
         out-of-institution GakuNin IdP or through Orthros. weko-accounts receives it as
         shib_organization, and _find_organization_name() matches it against the organizationName lists
         of WEKO_ACCOUNTS_GAKUNIN_ROLE / _ORTHROS_INSIDE_ROLE / _ORTHROS_OUTSIDE_ROLE / _EXTRA_ROLE to
         assign the corresponding defaultRole.
         Important: when this path matches, check_in() skips the GakuNin mAP group path entirely
         (`if not self._find_organization_name(): self._assign_roles_to_user(...)`), so a user who logs
         in with GakuNin authentication alone gets a role from the organization name, not from groups.
         id=o is already in IdP 5's stock attribute registry (conf/attributes/inetOrgPerson.xml), so no
         custom .properties file is needed. The SP side likewise maps urn:oid:2.5.4.10 -> o in the
         bundled attribute-map.xml, and nginx's shib_fastcgi_params forwards it as fastcgi_param o. -->
    <AttributeDefinition id="o" xsi:type="Mapped">
        <InputAttributeDefinition ref="uid" />
        <ValueMap>
            <ReturnValue>学認テスト機関</ReturnValue>
            <SourceValue>gakunin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>Orthros内部</ReturnValue>
            <SourceValue>orthrosin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>Orthros外部</ReturnValue>
            <SourceValue>orthrosout</SourceValue>
        </ValueMap>
    </AttributeDefinition>

    <!-- 学認mAP のグループ所属。本番の mAP が返すのと同じ形（グループのパス）で出す。
         weko-accounts は末尾のセグメントだけを見て
           jc_<IdP の FQDN>_ro_<suffix> … WEKO_ACCOUNTS_GAKUNIN_GROUP_PATTERN_DICT.role_mapping で変換
                                          (radm→Repository Administrator / cadm→Community Administrator
                                           / cont→Contributor)
           jc_roles_sysadm              … System Administrator
         と解釈する。FQDN 部分は WEKO_ACCOUNTS_IDP_ENTITY_ID から作られるので、IdP のホスト名を
         変えたらここも変えること (idp.localhost → idp_localhost)。

         GakuNin mAP group membership, emitted in the same shape the real mAP returns (a group path).
         weko-accounts only looks at the last path segment and reads it as
           jc_<IdP FQDN>_ro_<suffix> … mapped through WEKO_ACCOUNTS_GAKUNIN_GROUP_PATTERN_DICT.role_mapping
                                       (radm→Repository Administrator / cadm→Community Administrator
                                        / cont→Contributor)
           jc_roles_sysadm            … System Administrator
         The FQDN part is derived from WEKO_ACCOUNTS_IDP_ENTITY_ID, so changing the IdP host name means
         changing it here too (idp.localhost → idp_localhost). -->
    <!-- 値の形は本番の学認mAP に合わせている:
           __MAP_BASE__/<グループ名>          … そのグループのメンバー
           __MAP_BASE__/<グループ名>/admin    … そのグループの管理者
         (本番は https://cg.gakunin.jp/gr/<グループ名>)
         weko-accounts は最後のセグメントだけを見るのでホスト部分は何でもよいが、
         "/admin" で終わる値と "/sp/" を含む値は _assign_roles_to_user() が読み飛ばす。
         The value shape follows the real GakuNin mAP:
           __MAP_BASE__/<group>          … a member of that group
           __MAP_BASE__/<group>/admin    … an administrator of that group
         (production uses https://cg.gakunin.jp/gr/<group>)
         weko-accounts only looks at the last segment, so the host does not matter - but values ending
         in "/admin" and values containing "/sp/" are skipped by _assign_roles_to_user(). -->

    <!-- ① ロール決定用のグループ。ユーザごとに 1 つ。
         WEKO_ACCOUNTS_GAKUNIN_GROUP_PATTERN_DICT が解釈できる 4 種類すべてに、対応するデモユーザを
         1 人ずつ割り当ててある。SimpleAggregation 経路をロール単位で切り分けて検証できるようにするため。
           admin     -> jc_roles_sysadm         -> System Administrator     (sysadm_group、FQDN 無し)
           libadmin  -> jc_<FQDN>_ro_radm       -> Repository Administrator
           commadmin -> jc_<FQDN>_ro_cadm       -> Community Administrator
           teacher   -> jc_<FQDN>_ro_cont       -> Contributor              (DefaultValue)
         Group that decides the WEKO role; one per user. Every one of the four forms that
         WEKO_ACCOUNTS_GAKUNIN_GROUP_PATTERN_DICT understands has a demo user of its own, so the
         SimpleAggregation path can be verified one role at a time. -->
    <AttributeDefinition id="mapRoleGroup" xsi:type="Mapped">
        <InputAttributeDefinition ref="uid" />
        <!-- DefaultValue は置かない。置くと学認 / Orthros のユーザ (gakunin / orthrosin / orthrosout)
             にもロールグループが付いてしまい、あの 3 人が「組織名だけでロールが決まる」ことを
             示せなくなる。機関ユーザは 1 人ずつ明示する。
             No DefaultValue: it would hand a role group to the GakuNin / Orthros users
             (gakunin / orthrosin / orthrosout) as well, obscuring the point that those three get their
             role from the organization name alone. Institutional users are listed one by one. -->
        <ValueMap>
            <ReturnValue>__MAP_BASE__/jc___IDP_FQDN___ro_cont</ReturnValue>
            <SourceValue>teacher</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>__MAP_BASE__/jc_roles_sysadm</ReturnValue>
            <SourceValue>admin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>__MAP_BASE__/jc___IDP_FQDN___ro_radm</ReturnValue>
            <SourceValue>libadmin</SourceValue>
        </ValueMap>
        <!-- Community Administrator は wekoSocietyAffiliation では絶対に付かない
             (WEKO_ACCOUNTS_SHIB_ROLE_RELATION に該当する語が無い)。このグループ経由だけで付くので、
             mAP 連携が効いているかどうかの一番はっきりした試金石になる。
             Community Administrator can never come from wekoSocietyAffiliation - no word in
             WEKO_ACCOUNTS_SHIB_ROLE_RELATION maps to it. It arrives only through this group, which
             makes it the clearest litmus test that the mAP integration is working. -->
        <ValueMap>
            <ReturnValue>__MAP_BASE__/jc___IDP_FQDN___ro_cadm</ReturnValue>
            <SourceValue>commadmin</SourceValue>
        </ValueMap>
    </AttributeDefinition>

    <!-- ② 研究プロジェクトなどの一般グループ。同じユーザに複数マッチさせてよい
         (Mapped は一致した ValueMap を全部返す)。SourceValue は正規表現。
         Ordinary groups such as research projects. Several ValueMaps may match the same user - Mapped
         returns every match. SourceValue is a regular expression. -->
    <AttributeDefinition id="mapOrgGroup" xsi:type="Mapped">
        <InputAttributeDefinition ref="uid" />
        <ValueMap>
            <ReturnValue>__MAP_BASE__/research-project-a</ReturnValue>
            <SourceValue>libadmin|teacher</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>__MAP_BASE__/lib-staff</ReturnValue>
            <SourceValue>libadmin</SourceValue>
        </ValueMap>
        <!-- ここから下は検証用のグループ。ロール名にはマッチしないので、付いてもロールは増えない
             (weko-accounts はパターンに合わない値を素通りさせる)。所属パターンをわざとずらしてあり、
             SimpleAggregation で「誰にどの値が返るか」を切り分けられるようにしてある。
               test-group-1 … admin と libadmin の 2 人      (複数ユーザが同じグループ)
               test-group-2 … teacher と commadmin の 2 人   (別の組み合わせ)
               test-group-3 … commadmin だけ                 (単独所属)
             The groups below are for verification only. They match no role name, so they add no role
             (weko-accounts simply passes over values that fit no pattern). The membership patterns are
             deliberately staggered so that "who gets which value" can be told apart over
             SimpleAggregation. -->
        <ValueMap>
            <ReturnValue>__MAP_BASE__/test-group-1</ReturnValue>
            <SourceValue>admin|libadmin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>__MAP_BASE__/test-group-2</ReturnValue>
            <SourceValue>teacher|commadmin</SourceValue>
        </ValueMap>
        <ValueMap>
            <ReturnValue>__MAP_BASE__/test-group-3</ReturnValue>
            <SourceValue>commadmin</SourceValue>
        </ValueMap>
    </AttributeDefinition>

    <!-- ③ グループの管理者であることを表す "/admin" 付きの値。mAP はメンバーとしての値と
         セットで返す。weko-accounts はこれを読み飛ばすので、ロールは増えない
         (管理者かどうかを WEKO 側のロールには反映しない設計)。
         The "/admin" flavour that marks a group administrator; mAP returns it alongside the plain
         membership value. weko-accounts skips it, so it grants no extra role - being a group admin is
         deliberately not reflected in the WEKO roles. -->
    <AttributeDefinition id="mapOrgAdminGroup" xsi:type="Mapped">
        <InputAttributeDefinition ref="uid" />
        <ValueMap>
            <ReturnValue>__MAP_BASE__/research-project-a/admin</ReturnValue>
            <SourceValue>libadmin</SourceValue>
        </ValueMap>
        <!-- 読み飛ばしの確認用。admin は test-group-1 のメンバー値と管理者値の両方を受け取るので、
             _assign_roles_to_user() が "/admin" で終わる値だけを捨てていることを確かめられる。
             For checking the skip rule: admin receives both the member value and the admin value for
             test-group-1, which shows _assign_roles_to_user() discarding only the one ending in
             "/admin". -->
        <ValueMap>
            <ReturnValue>__MAP_BASE__/test-group-1/admin</ReturnValue>
            <SourceValue>admin</SourceValue>
        </ValueMap>
    </AttributeDefinition>

    <!-- ④ 全員が入る共通グループ。Static データコネクタに <Value> を並べれば増やせる。
         A common group everyone belongs to; add more <Value> entries to the Static connector. -->
    <AttributeDefinition id="mapCommonGroup" xsi:type="Simple">
        <InputDataConnector ref="staticAttributes" attributeNames="commonGroup" />
    </AttributeDefinition>

    <!-- ①〜④ を 1 つの isMemberOf にまとめる。Simple 属性定義は入力を全部連結するので、
         種類ごとに分けて定義したものを束ねられる。値が無い入力は単に無視される。
         SP は多値属性を ";" 区切りで 1 つの環境変数に入れ、weko-accounts の ShibUser.__init__ が
         ";" で split してリストに戻す。
         Merge (1)-(4) into a single isMemberOf. A Simple definition concatenates all its inputs, so the
         categories can be defined separately and bundled here; inputs with no value are simply skipped.
         The SP joins a multi-valued attribute into one environment variable separated by ";", and
         weko-accounts' ShibUser.__init__ splits it back on ";". -->
    <AttributeDefinition id="isMemberOf" xsi:type="Simple">
        <InputAttributeDefinition ref="mapRoleGroup" />
        <InputAttributeDefinition ref="mapOrgGroup" />
        <InputAttributeDefinition ref="mapOrgAdminGroup" />
        <InputAttributeDefinition ref="mapCommonGroup" />
    </AttributeDefinition>

    <!-- 参考用の標準属性 / standard attribute, for reference -->
    <AttributeDefinition id="eduPersonScopedAffiliation" xsi:type="Scoped" scope="%{idp.scope}">
        <InputDataConnector ref="staticAttributes" attributeNames="affiliation" />
    </AttributeDefinition>

    <DataConnector id="staticAttributes" xsi:type="Static" exportAttributes="schacHomeOrganization commonGroup">
        <Attribute id="schacHomeOrganization">
            <Value>%{idp.scope}</Value>
        </Attribute>
        <Attribute id="affiliation">
            <Value>member</Value>
        </Attribute>
        <Attribute id="commonGroup">
            <Value>__MAP_BASE__/all_users</Value>
        </Attribute>
    </DataConnector>

</AttributeResolver>
