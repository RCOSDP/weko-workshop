<?xml version="1.0" encoding="UTF-8"?>
<!--
  WEKO3 nginx コンテナに同梱の Shibboleth SP (shibd) 用の設定。provision-shib.sh がテナントごとに
  __WEKO3_VHOST__ / __IDP_ENTITYID__ を置換して NFS の /fs-shibboleth/<tenant> に配置する。
  Configuration for the Shibboleth SP (shibd) bundled in the WEKO3 nginx container. provision-shib.sh
  substitutes __WEKO3_VHOST__ / __IDP_ENTITYID__ per tenant and places it in /fs-shibboleth/<tenant> on NFS.

  本番 (weko-k8s の shibboleth_template) との違い / differences from production:
    - 学認のフェデレーションメタデータを取りに行かず、ローカルの idp-metadata.xml だけを信頼する
      Instead of fetching the GakuNin federation metadata, only the local idp-metadata.xml is trusted
    - TLS は Ingress で終端するので handlerSSL/cookieProps は https 前提。nginx 側が
      HTTPS=on / SERVER_PORT=443 を FastCGI パラメータで渡すことで shibd から見ても https になる
      TLS terminates at the Ingress, so handlerSSL/cookieProps assume https; nginx passes
      HTTPS=on / SERVER_PORT=443 as FastCGI parameters so shibd sees https as well
    - WEKO 固有属性 (wekoId / wekoSocietyAffiliation) はイメージ同梱の attribute-map.xml に無いので、
      Chaining で attribute-map-weko.xml を足している
      The WEKO-specific attributes (wekoId / wekoSocietyAffiliation) are missing from the image's
      attribute-map.xml, so attribute-map-weko.xml is chained in
-->
<SPConfig xmlns="urn:mace:shibboleth:3.0:native:sp:config"
    xmlns:conf="urn:mace:shibboleth:3.0:native:sp:config"
    clockSkew="180">

    <OutOfProcess tranLogFormat="%u|%s|%IDP|%i|%ac|%t|%attr|%n|%b|%E|%S|%SS|%L|%UA|%a" />
    <UnixListener address="/tmp/shibd.sock"/>

    <!-- /secure/ 以下だけセッションを要求する。nginx も shib_request をこのパスにしか掛けていない。
         Only /secure/ requires a session; nginx also applies shib_request to that path only. -->
    <RequestMapper type="XML">
        <RequestMap>
            <Host name="__WEKO3_VHOST__">
                <Path name="secure" authType="shibboleth" requireSession="true"/>
            </Host>
        </RequestMap>
    </RequestMapper>

    <!-- entityID は weko-accounts が組み立てる値 (https://<host>/shibboleth-sp) に合わせる。
         The entityID matches the value weko-accounts constructs (https://<host>/shibboleth-sp). -->
    <!-- signing="back": バックチャネル (SOAP) で送るメッセージに署名する。SimpleAggregation の
         AttributeQuery は署名が無いと IdP に MessageAuthenticationError で拒否される。
         フロントチャネル (AuthnRequest) は既定どおり署名しない。
         signing="back": sign the messages sent over the back-channel (SOAP). Without a signature the
         SimpleAggregation AttributeQuery is rejected by the IdP with MessageAuthenticationError.
         The front-channel (AuthnRequest) stays unsigned, as by default. -->
    <ApplicationDefaults entityID="https://__WEKO3_VHOST__/shibboleth-sp"
        REMOTE_USER="eppn persistent-id targeted-id"
        signing="back"
        cipherSuites="DEFAULT:!EXP:!LOW:!aNULL:!eNULL:!DES:!IDEA:!SEED:!RC4:!3DES:!kRSA:!SSLv2:!SSLv3:!TLSv1:!TLSv1.1">

        <Sessions lifetime="28800" timeout="3600" relayState="ss:mem"
                  checkAddress="false" handlerSSL="true" cookieProps="https">

            <!-- IdP は 1 つだけなので DS (WAYF) は使わず entityID を直接指定する。
                 There is only one IdP, so no DS (WAYF): the entityID is given directly. -->
            <SSO entityID="__IDP_ENTITYID__">
              SAML2
            </SSO>

            <Logout>SAML2 Local</Logout>

            <LogoutInitiator type="Admin" Location="/Logout/Admin" acl="127.0.0.1 ::1" />
            <Handler type="MetadataGenerator" Location="/Metadata" signing="false"/>
            <Handler type="Status" Location="/Status" acl="127.0.0.1 ::1"/>
            <Handler type="Session" Location="/Session" showAttributeValues="false"/>
            <Handler type="DiscoveryFeed" Location="/DiscoFeed"/>
        </Sessions>

        <Errors supportContact="root@localhost"
            helpLocation="/about.html"
            styleSheet="/shibboleth-sp/main.css"/>

        <!-- ローカルに置いた IdP のメタデータだけを信頼する (署名検証もフェデレーション取得もしない)。
             Trust only the locally placed IdP metadata (no signature check, no federation fetch). -->
        <MetadataProvider type="XML" validate="true" path="idp-metadata.xml"/>
__MAP_METADATA__

        <AttributeExtractor type="Chaining">
            <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map.xml"/>
            <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map-weko.xml"/>
        </AttributeExtractor>
__SIMPLE_AGGREGATION__

        <AttributeFilter type="XML" validate="true" path="attribute-policy.xml"/>

        <!-- provision-shib.sh が生成した SP 鍵。SP メタデータにも同じ証明書が入る。
             The SP key generated by provision-shib.sh; the same certificate is embedded in the SP metadata. -->
        <CredentialResolver type="File" use="signing"
            key="sp-key.pem" certificate="sp-cert.pem"/>
        <CredentialResolver type="File" use="encryption"
            key="sp-key.pem" certificate="sp-cert.pem"/>

    </ApplicationDefaults>

    <SecurityPolicyProvider type="XML" validate="true" path="security-policy.xml"/>
    <ProtocolProvider type="XML" validate="true" reloadChanges="false" path="protocols.xml"/>

</SPConfig>
