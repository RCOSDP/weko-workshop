# 秘密情報 / secrets
# gen-tenant.sh が生成する seed。これがあれば全テナントの Secret が再現できる
# Seed generated by gen-tenant.sh; it can reproduce every tenant secret.
.secret-seed
*.key
*.pem

# 生成物 / generated artifacts
# gen-tenant.sh の出力(Secret を含む)。デプロイ時に再生成される
# Output of gen-tenant.sh (contains Secrets); regenerated at deploy time.
generated/

# make-amd64-dist.sh の出力 / output of make-amd64-dist.sh
weko-k8s-amd64-dist.tar.gz
*.tar.gz

# 作業用バックアップ / working backups
*.bak
*.bak[0-9]
*~

# ローカル設定 / local settings
.claude/settings.local.json
